# Copy to .env and adjust for your deployment.
# Settings are read by config/loader.py; every variable here has a sane default,
# so the application also boots with no .env at all.

# --- Database ----------------------------------------------------------------
DATABASE_URL=sqlite:///data/retail_intelligence.db

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO

# --- Real ML inference -------------------------------------------------------
# Point at a downloaded ultralytics checkpoint, e.g. yolov8n.pt
YOLO_MODEL_PATH=models/yolo/yolov8n.pt
USE_GPU=false

# --- Edge / device -----------------------------------------------------------
EDGE_DEVICE=                # e.g. jetson_orin_nano, rpi5
EDGE_TRT_ENGINE=models/yolo/yolov8n_fp16.engine